<mxfile host="app.diagrams.net"><diagram name="Fig. 1 methodology"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="data" value="Diabetes 130-US&lt;br&gt;Hospitals dataset&lt;br&gt;101,766 encounters&lt;br&gt;71,518 patients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeec;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="9" y="9" width="153" height="90" as="geometry"/></mxCell><mxCell id="prep" value="Cohort and features&lt;br&gt;exclude death/hospice (2,423)&lt;br&gt;ICD-9 groups, 3-digit codes,&lt;br&gt;medication counts,&lt;br&gt;patient history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeec;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="189" y="9" width="234" height="90" as="geometry"/></mxCell><mxCell id="split" value="Patient-level split&lt;br&gt;stratified group 5-fold&lt;br&gt;on patient ID&lt;br&gt;(no shared patients)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeec;strokeColor=#52514e;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="459" y="9" width="234" height="90" as="geometry"/></mxCell><mxCell id="trainset" value="Training set&lt;br&gt;55,952 patients&lt;br&gt;79,625 encounters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce9f9;strokeColor=#2a78d6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="729" y="9" width="162" height="90" as="geometry"/></mxCell><mxCell id="tune" value="Optuna tuning&lt;br&gt;(TPE sampler)&lt;br&gt;PR-AUC on&lt;br&gt;grouped folds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce9f9;strokeColor=#2a78d6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="729" y="144" width="162" height="81" as="geometry"/></mxCell><mxCell id="base" value="Base learners&lt;br&gt;XGBoost&lt;br&gt;LightGBM&lt;br&gt;CatBoost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce9f9;strokeColor=#2a78d6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="549" y="144" width="153" height="81" as="geometry"/></mxCell><mxCell id="oof" value="Patient-grouped&lt;br&gt;5-fold out-of-fold&lt;br&gt;probabilities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce9f9;strokeColor=#2a78d6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="369" y="144" width="153" height="81" as="geometry"/></mxCell><mxCell id="meta" value="LR meta-learner&lt;br&gt;on logits (Eq. 1)&lt;br&gt;or simple average" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce9f9;strokeColor=#2a78d6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="189" y="144" width="153" height="81" as="geometry"/></mxCell><mxCell id="calib" value="Calibration&lt;br&gt;(none/Platt/isotonic),&lt;br&gt;thresholds (max-F1,&lt;br&gt;recall 0.70)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dce9f9;strokeColor=#2a78d6;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="9" y="144" width="153" height="81" as="geometry"/></mxCell><mxCell id="testset" value="Test set (used once)&lt;br&gt;14,038 patients&lt;br&gt;19,718 encounters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde3d6;strokeColor=#eb6834;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="666" y="270" width="225" height="81" as="geometry"/></mxCell><mxCell id="eval" value="Refitted models on test set&lt;br&gt;ROC-AUC, PR-AUC, Brier, ECE, F1&lt;br&gt;patient-level bootstrap 95% CI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde3d6;strokeColor=#eb6834;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="9" y="270" width="306" height="81" as="geometry"/></mxCell><mxCell id="shap" value="TreeSHAP per base model&lt;br&gt;weighted by meta-learner&lt;br&gt;= exact stack attributions (Eq. 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcf3ea;strokeColor=#1baf7a;f